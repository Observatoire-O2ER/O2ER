---
import BaseLayout from "../../layouts/BaseLayout.astro";
import NavBar from "../../components/NavBar.astro";
import Footer from "../../components/Footer.astro";
---

<BaseLayout title="Actions — O₂ER">
  <Fragment slot="nav"><NavBar /></Fragment>

  <h1>Analyses et actions</h1>
  
  <p>Cette section regroupe les dossiers, actions collectives et analyses produites par l’O₂ER.<br>
    Elle sera mise à jour au fur et à mesure des actions. Restez connectés !
  </p>

  <!-- ANALYSES -->
  <section class="category">
    <h2>Analyses</h2>

    <article>
      <h3>
        <a href="/O2ER/actions/la_recherche_procedures">
          La recherche publique à l’épreuve de ses propres procédures
        </a>
      </h3>
      <p>
        Texte appelant à une clarification juridique et à une sécurisation
        des pratiques disciplinaires.
      </p>
    </article>
  </section>

  <!-- ACTIONS -->
  <section class="category">
    <h2>Actions</h2>

    <article>
      <h3>
        <a href="#">
          Action à venir
        </a>
      </h3>
    </article>
  </section>

  <!-- ENTRETIENS -->
  <section class="category">
    <h2>Entretiens</h2>

    <article>
      <h3>
        <a href="#">
          Entretien à venir
        </a>
      </h3>
    </article>
  </section>

  <Fragment slot="footer"><Footer /></Fragment>
</BaseLayout>

<style>
  .category {
    margin-top: 3rem;
  }

  .category h2 {
    border-bottom: 2px solid #0b0f1a;
    padding-bottom: 0.4rem;
    margin-bottom: 1rem;
  }

  article {
    margin-bottom: 1.5rem;
  }

  article h3 {
    margin-bottom: 0.3rem;
  }

  article a {
    text-decoration: none;
    color: inherit;
  }

  article a:hover {
    text-decoration: underline;
  }
</style>
